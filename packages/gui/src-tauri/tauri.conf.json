{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Revamp",
  "mainBinaryName": "revamp-gui",
  "version": "1.0.0",
  "identifier": "dev.revamp.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [{ "label": "main", "title": "Revamp", "width": 980, "height": 700, "minWidth": 760, "minHeight": 520 }],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": {
    "active": false,
    "externalBin": ["binaries/revamp"],
    "icon": ["icons/icon.png"]
  }
}
